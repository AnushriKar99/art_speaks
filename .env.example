# Supabase — copy to .env.local and fill in from
# Supabase Dashboard → Project Settings → API.
# The anon/publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, never expose to the client / never prefix
# with NEXT_PUBLIC_. Needed later for server-side order creation. Leave unset
# until then.
# SUPABASE_SERVICE_ROLE_KEY=
