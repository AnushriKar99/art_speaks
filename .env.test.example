# Playwright points at a SEPARATE Supabase project, never the live one —
# the tests place orders and mark them paid, which deducts real stock.
#
# Copy to .env.test and fill in from the TEST project's dashboard.
# .env.test is gitignored; this example file is not.

NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# An admin account on the test project. Create it under
# Auth → Users → Add user (tick Auto Confirm), then:
#   update public.profiles set is_admin = true
#   where id = (select id from auth.users where email = '<this email>');
E2E_ADMIN_EMAIL=test-admin@example.com
E2E_ADMIN_PASSWORD=
